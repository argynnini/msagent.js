{
  "name": "@argynnini/msagent.js",
  "version": "0.1.0",
  "description": "Play Microsoft Agent (.acs) and Office 97 Assistant (.act) characters in the browser",
  "type": "module",
  "main": "./dist/msagent.js",
  "module": "./dist/msagent.js",
  "types": "./dist/msagent.d.ts",
  "exports": {
    ".": {
      "types": "./dist/msagent.d.ts",
      "import": "./dist/msagent.js"
    }
  },
  "unpkg": "./dist/msagent.iife.js",
  "jsdelivr": "./dist/msagent.iife.js",
  "files": [
    "dist/msagent.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "msagent",
    "microsoft-agent",
    "acs",
    "clippy",
    "office-assistant",
    "canvas",
    "animation"
  ],
  "author": "Argynnini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argynnini/msagent.js.git"
  },
  "scripts": {
    "dev": "vite example",
    "build": "vite build && vite build --mode global && tsc -p tsconfig.build.json && rollup -c && tsc -p tsconfig.dist.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "license": "MIT"
}
